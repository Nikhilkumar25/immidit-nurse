{
  "expo": {
    "name": "immidit Nurse",
    "slug": "immidit-nurse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "immidit-nurse",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/415bf27c-b927-452f-8127-1447296c1269"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#006D77"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "immidit Nurse requires camera access to capture clinical photos for case documentation.",
        "NSLocationWhenInUseUsageDescription": "immidit Nurse uses your location to GPS-tag arrival at patient sites for accurate case records."
      }
    },
    "android": {
      "package": "com.immidit.nurse",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#006D77"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "immidit Nurse requires camera access to capture clinical photos for case documentation."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "immidit Nurse uses your location to GPS-tag arrival at patient sites."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "415bf27c-b927-452f-8127-1447296c1269"
      }
    },
    "owner": "nikhil_kumar"
  }
}
